<% content_for :title, "Bejelentkezés" %>

<div class="auth-box">
  <h1 class="auth-title">Bejelentkezés</h1>

  <%= form_with url: login_path, method: :post, local: true do %>
    <div class="form-group">
      <%= label_tag :login, "Felhasználónév vagy e-mail", class: "form-label" %>
      <%= text_field_tag :login, params[:login], class: "form-control", required: true, autofocus: true, placeholder: "pl. bence99" %>
    </div>

    <div class="form-group">
      <%= label_tag :password, "Jelszó", class: "form-label" %>
      <%= password_field_tag :password, nil, class: "form-control", required: true, placeholder: "••••••••" %>
    </div>

    <div class="form-group">
      <%= submit_tag "Belépés", class: "btn btn-primary btn-block" %>
    </div>
  <% end %>

  <div class="auth-sublink">
    <%= link_to "Elfelejtett jelszó?", new_password_reset_path %>
  </div>

  <div class="auth-footer">
    Még nincs fiókod? <%= link_to "Regisztráció", register_path %>
  </div>
</div>
