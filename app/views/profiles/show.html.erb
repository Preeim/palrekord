<% content_for :title, "Saját profil" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Saját profil</h1>
    <p class="page-subtitle">
      Felhasználónév: <strong><%= @user.username %></strong> ·
      Szerepkör: <strong><%= @user.role %></strong>
    </p>
  </div>
  <%= link_to "+ Új rekord beküldése", new_record_path, class: "btn btn-primary" %>
</div>

<% if @user.errors.any? %>
  <div class="error-box">
    <strong>Hiba történt a mentés során:</strong>
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="profile-stats-grid">
  <div class="stat-card">
    <div class="stat-label">ÖRÖKÖS ÉLŐ PONTSZÁM</div>
    <div class="stat-value-row">
      <span class="stat-value"><%= @overall_entry.total_points %> pont</span>
      <span class="stat-rank">
        <% if @overall_entry.rank.present? %>
          (<%= @overall_entry.rank %>. hely az összetettben)
        <% else %>
          (még nincs helyezés)
        <% end %>
      </span>
    </div>
    <div class="stat-hint">
      <%= @overall_entry.categories_count %> aktív kategóriában szerzett helyezések alapján
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-label">
      <% if @current_season.present? %>
        <%= @current_season.name.upcase %> (AKTÍV)
      <% else %>
        SZEZONÁLIS VERSENY
      <% end %>
    </div>
    <% if @current_season.present? %>
      <div class="stat-value-row">
        <span class="stat-value"><%= @seasonal_entry.total_points %> pont</span>
        <span class="stat-rank">
          <% if @seasonal_entry.rank.present? %>
            (<%= @seasonal_entry.rank %>. hely a szezonban)
          <% else %>
            (még nincs szezonbeli pont)
          <% end %>
        </span>
      </div>
      <div class="stat-hint">
        Csak a <%= @current_season.period_label %> között indított kategóriák
      </div>
    <% else %>
      <div class="stat-value-row">
        <span class="stat-value">–</span>
      </div>
      <div class="stat-hint">Jelenleg nincs aktív szezonális verseny</div>
    <% end %>
  </div>

  <div class="stat-card">
    <div class="stat-label">HAVI KATEGÓRIA KVÓTA</div>
    <% if @user.admin? %>
      <div class="stat-value-row">
        <span class="stat-value">Korlátlan</span>
      </div>
      <div class="stat-hint">Adminisztrátorként nem vonatkozik rád a havi limit</div>
    <% else %>
      <% remaining = @user.remaining_category_quota %>
      <% limit = Setting.monthly_category_limit %>
      <div class="stat-value-row">
        <span class="stat-value"><%= remaining %> / <%= limit %> szabad</span>
      </div>
      <div class="stat-hint">
        <% if !Setting.members_can_create_categories? %>
          A tagok általi kategórialétrehozás jelenleg ki van kapcsolva
        <% elsif remaining.positive? %>
          Ebben a hónapban még <%= remaining %> új versenyszámot hozhatsz létre
        <% else %>
          Elérted a havi keretet · Következő nyitás: <%= @user.next_category_quota_reset_date.strftime("%Y-%m-%d") %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<h2 class="section-title">Pontjaim tételes lebontása</h2>

<% if @overall_entry.breakdown.any? %>
  <div class="table-wrap">
    <table class="minimal-table">
      <thead>
        <tr>
          <th>Kategória</th>
          <th>Saját legjobb</th>
          <th>Helyezés / Létszám</th>
          <th>Kapott pont</th>
          <th>Szezonális?</th>
        </tr>
      </thead>
      <tbody>
        <% @overall_entry.breakdown.each do |item| %>
          <% in_current_season = @current_season.present? && item.category_created_at >= @current_season.starts_at && item.category_created_at <= @current_season.ends_at %>
          <tr>
            <td><%= link_to item.category_name, category_path(item.category_id), class: "category-link" %></td>
            <td class="record-value"><%= item.display_value %></td>
            <td class="meta-text"><%= item.rank %>. hely / <%= item.participants_count %> fő</td>
            <td><%= points_badge(item.points, rank: item.rank) %></td>
            <td>
              <% if in_current_season %>
                <span class="badge badge-season">Igen (<%= @current_season.name %>)</span>
              <% else %>
                <span class="meta-text">Nem (csak Örökös)</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="form-hint" style="margin-top: 8px;">
    Összesen: <strong><%= @overall_entry.total_points %> pt</strong> Örökös<% if @current_season.present? %> · ebből <strong><%= @seasonal_entry.total_points %> pt</strong> Szezonális (<%= @current_season.name %>)<% end %>.
  </p>
<% else %>
  <div class="card">
    <p class="empty-state">Még nincs pontszerző elfogadott rekordod aktív kategóriában.</p>
  </div>
<% end %>

<div class="form-row" style="margin-top: 24px;">
  <div class="card" style="flex: 1 1 320px;">
    <h2 class="section-title" style="margin-top: 0;">Profiladatok</h2>
    <%= form_with model: @user, url: profile_path, method: :patch, local: true do |f| %>
      <div class="form-group">
        <%= f.label :display_name, "Megjelenített név *", class: "form-label" %>
        <%= f.text_field :display_name, class: "form-control", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :email, (Setting.email_system? ? "E-mail cím *" : "E-mail cím (opcionális)"), class: "form-label" %>
        <%= f.email_field :email, class: "form-control", required: Setting.email_system? %>
      </div>

      <%= f.submit "Adatok mentése", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="card" style="flex: 1 1 320px;">
    <h2 class="section-title" style="margin-top: 0;">Jelszócsere</h2>
    <%= form_with url: profile_password_path, method: :patch, local: true do %>
      <div class="form-group">
        <%= label_tag :current_password, "Jelenlegi jelszó *", class: "form-label" %>
        <%= password_field_tag :current_password, nil, class: "form-control", required: true %>
      </div>

      <div class="form-group">
        <%= label_tag :password, "Új jelszó * (min. 8 karakter)", class: "form-label" %>
        <%= password_field_tag :password, nil, class: "form-control", required: true %>
      </div>

      <div class="form-group">
        <%= label_tag :password_confirmation, "Új jelszó megerősítése *", class: "form-label" %>
        <%= password_field_tag :password_confirmation, nil, class: "form-control", required: true %>
      </div>

      <%= submit_tag "Jelszó frissítése", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<h2 class="section-title">Saját beküldött rekordok</h2>

<% if @records.any? %>
  <div class="table-wrap">
    <table class="minimal-table">
      <thead>
        <tr>
          <th>Versenyszám</th>
          <th>Eredmény</th>
          <th>Teljesítés</th>
          <th>Státusz / Megjegyzés</th>
          <th>Műveletek</th>
        </tr>
      </thead>
      <tbody>
        <% @records.each do |record| %>
          <tr>
            <td><%= link_to record.category.name, category_path(record.category), class: "category-link" %></td>
            <td class="record-value"><%= record.category.display_record_value(record) %></td>
            <td class="meta-text"><%= record.achieved_at.strftime("%Y-%m-%d") %></td>
            <td>
              <%= status_badge(record.status) %>
              <% if record.admin_comment.present? %>
                <div class="form-hint"><strong>Admin megjegyzés:</strong> <%= record.admin_comment %></div>
              <% end %>
            </td>
            <td>
              <% if record.pending? || admin? %>
                <div class="actions-inline">
                  <%= link_to "Szerkesztés", edit_record_path(record), class: "btn btn-outline btn-sm" %>
                  <%= button_to "Törlés", record_path(record), method: :delete,
                    data: { turbo_confirm: "Biztosan törlöd ezt a rekordot?" },
                    class: "btn btn-danger btn-sm" %>
                </div>
              <% else %>
                <span class="meta-text">–</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card">
    <p class="empty-state">Még nem küldtél be rekordot.</p>
  </div>
<% end %>
