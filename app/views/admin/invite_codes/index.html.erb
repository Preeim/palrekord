<% content_for :title, "Admin – Meghívókódok" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Adminisztráció – Meghívókódok</h1>
    <p class="page-subtitle">Zárt regisztrációhoz használható meghívókódok létrehozása és kezelése.</p>
  </div>
</div>

<%= render "admin/nav" %>

<div class="card">
  <h2 class="section-title" style="margin-top: 0;">Új meghívókód generálása</h2>

  <% if @invite_code.errors.any? %>
    <div class="error-box">
      <ul>
        <% @invite_code.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [:admin, @invite_code], url: admin_invite_codes_path, local: true do |f| %>
    <div class="form-row">
      <div class="form-group">
        <%= f.label :code, "Kód (üresen hagyva automatikus)", class: "form-label" %>
        <%= f.text_field :code, class: "form-control", placeholder: "pl. PAL-BARAT26" %>
      </div>

      <div class="form-group">
        <%= f.label :label, "Megjegyzés (kinek készült)", class: "form-label" %>
        <%= f.text_field :label, class: "form-control", placeholder: "pl. Kovács Petiéknek" %>
      </div>

      <div class="form-group">
        <%= f.label :max_uses, "Max felhasználás (üres = korlátlan)", class: "form-label" %>
        <%= f.number_field :max_uses, class: "form-control", min: 1 %>
      </div>

      <div class="form-group">
        <%= f.label :expires_at, "Lejárat (opcionális)", class: "form-label" %>
        <%= f.datetime_local_field :expires_at, class: "form-control" %>
      </div>
    </div>

    <%= f.submit "Meghívókód létrehozása", class: "btn btn-primary" %>
  <% end %>
</div>

<div class="table-wrap">
  <table class="minimal-table">
    <thead>
      <tr>
        <th>Kód</th>
        <th>Megjegyzés</th>
        <th>Használat</th>
        <th>Lejárat</th>
        <th>Állapot</th>
        <th>Műveletek</th>
      </tr>
    </thead>
    <tbody>
      <% @invite_codes.each do |invite| %>
        <tr>
          <td><code><%= invite.code %></code></td>
          <td class="meta-text"><%= invite.label.presence || "–" %></td>
          <td class="meta-text"><%= invite.usage_summary %></td>
          <td class="meta-text"><%= invite.expires_at ? invite.expires_at.strftime("%Y-%m-%d %H:%M") : "Nincs" %></td>
          <td>
            <% if invite.usable? %>
              <span class="badge badge-approved">Használható</span>
            <% else %>
              <span class="badge badge-muted">Inaktív / lejárt</span>
            <% end %>
          </td>
          <td>
            <div class="actions-inline">
              <%= button_to(invite.is_active? ? "Kikapcsolás" : "Aktiválás",
                admin_invite_code_path(invite),
                method: :patch,
                params: { invite_code: { is_active: !invite.is_active? } },
                class: "btn btn-outline btn-sm") %>
              <%= button_to "Törlés",
                admin_invite_code_path(invite),
                method: :delete,
                data: { turbo_confirm: "Biztosan törlöd a #{invite.code} meghívókódot?" },
                class: "btn btn-danger btn-sm" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
