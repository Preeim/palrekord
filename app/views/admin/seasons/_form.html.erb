<% if season.errors.any? %>
  <div class="error-box">
    <strong>A szezon mentése nem sikerült:</strong>
    <ul>
      <% season.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [ :admin, season ], local: true do |f| %>
  <div class="form-row">
    <div class="form-group">
      <%= f.label :name, "Szezon neve *", class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true, placeholder: "pl. 2026 Őszi Szezon" %>
    </div>

    <div class="form-group">
      <%= f.label :starts_at, "Szezon kezdete *", class: "form-label" %>
      <%= f.datetime_local_field :starts_at, class: "form-control", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :ends_at, "Szezon vége *", class: "form-label" %>
      <%= f.datetime_local_field :ends_at, class: "form-control", required: true %>
    </div>
  </div>

  <div class="actions-inline">
    <%= f.submit(season.persisted? ? "Változtatások mentése" : "Szezon létrehozása", class: "btn btn-primary") %>
    <% if season.persisted? %>
      <%= link_to "Mégse", admin_seasons_path, class: "btn btn-outline" %>
    <% end %>
  </div>
<% end %>
