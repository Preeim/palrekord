<% content_for :title, @category.name %>

<div class="page-header">
  <div>
    <h1 class="page-title">
      <%= @category.name %>
      <% if @category.is_archived? %>
        <span class="badge badge-muted">Archivált</span>
      <% end %>
      <% if @category_season.present? %>
        <span class="badge badge-season"><%= @category_season.name %></span>
      <% end %>
    </h1>
    <p class="page-subtitle">
      Mértékegység: <strong><%= @category.unit %></strong> ·
      Rendezés: <strong><%= @category.sort_by_label %></strong> ·
      Résztvevők: <strong><%= @standings.participants_count %> fő</strong><% unless @category.is_archived? %> (1. hely = <strong><%= @standings.max_points %> pt</strong>)<% end %>
    </p>
  </div>

  <div class="actions-inline">
    <%= link_to "← Vissza", root_path, class: "btn btn-outline" %>
    <% if logged_in? && !@category.is_archived? %>
      <%= link_to "Rekord beküldése", new_record_path(category_id: @category.id), class: "btn btn-primary" %>
    <% end %>
    <% if admin? %>
      <%= link_to "Kategória szerkesztése", edit_category_path(@category), class: "btn btn-outline" %>
    <% end %>
  </div>
</div>

<% if @category.description.present? || @category.recommended_file_type.present? || @category.verification_hint.present? %>
  <div class="card">
    <% if @category.description.present? %>
      <div>
        <strong>Szabályzat / leírás:</strong>
        <div><%= simple_format(h(@category.description)) %></div>
      </div>
    <% end %>
    <% if @category.recommended_file_type.present? || @category.verification_hint.present? %>
      <div style="<%= 'margin-top: 10px; padding-top: 10px; border-top: 1px solid #eeeeee;' if @category.description.present? %>">
        <strong>Ajánlott verifikáció:</strong>
        <%= recommended_proof_badge(@category.recommended_file_type) %>
        <% if @category.verification_hint.present? %>
          <span class="meta-text" style="margin-left: 6px;"><%= @category.verification_hint %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<h2 class="section-title">Ranglista (Elfogadott rekordok)</h2>

<% if @standings.entries.any? %>
  <div class="table-wrap">
    <table class="minimal-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Versenyző</th>
          <th>Eredmény</th>
          <th>Teljesítés / Beküldés</th>
          <th>Helyezési pont</th>
          <th>Verifikáció</th>
          <th>Megjegyzés</th>
        </tr>
      </thead>
      <tbody>
        <% @standings.entries.each do |entry| %>
          <% record = entry.record %>
          <% is_current = logged_in? && entry.user_id == current_user.id %>
          <% row_class = if !entry.personal_best?
                           "row-secondary-attempt"
                         elsif is_current
                           "leaderboard-row-current"
                         end %>
          <tr class="<%= row_class %>">
            <td>
              <% if entry.personal_best? %>
                <strong><%= entry.rank %>.</strong>
              <% else %>
                <span class="meta-text">–</span>
              <% end %>
            </td>
            <td>
              <% if entry.personal_best? %>
                <%= entry.user.display_name %><%= " (Te)" if is_current %>
              <% else %>
                <span class="meta-text"><%= entry.user.display_name %> (korábbi kísérlet)</span>
              <% end %>
            </td>
            <td class="<%= entry.personal_best? ? 'record-value' : 'meta-text' %>">
              <%= @category.display_record_value(record) %>
            </td>
            <td class="meta-text">
              <div><%= record.achieved_at.strftime("%Y-%m-%d") %></div>
              <div class="form-hint">Beküldve: <%= record.created_at.strftime("%Y-%m-%d %H:%M") %></div>
            </td>
            <td>
              <% if entry.personal_best? %>
                <%= points_badge(entry.points, rank: entry.rank, archived: @category.is_archived?) %>
              <% else %>
                <span class="meta-text">0 pt</span>
              <% end %>
            </td>
            <td>
              <% if record.attachments.any? %>
                <ul class="attachment-list">
                  <% record.attachments.each do |attachment| %>
                    <li>
                      <%= attachment_type_badge(attachment) %>
                      <% if attachment.file_attachment? %>
                        <%= link_to(attachment.original_filename.presence || attachment.file_type, attachment_path(attachment), target: "_blank", rel: "noopener") %>
                      <% elsif attachment.link? %>
                        <%= link_to "Külső hivatkozás", attachment.file_path_or_url, target: "_blank", rel: "noopener noreferrer" %>
                      <% elsif attachment.text? %>
                        <span><%= truncate(attachment.text_content, length: 90) %></span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <span class="empty-state">Nincs</span>
              <% end %>
            </td>
            <td class="meta-text">
              <%= record.note.presence || "–" %>
              <% if entry.tied_sort_value %>
                <div class="form-hint">
                  <%= entry.tied_earlier ? "Holtverseny: korábban feltöltve → előrébb áll" : "Holtverseny: későbbi feltöltés → #{entry.rank}. hely" %>
                </div>
              <% elsif !entry.personal_best? %>
                <div class="form-hint">Saját gyengébb kísérlet – nem foglal helyet és nem ad pontot</div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card">
    <p class="empty-state">Még nincs elfogadott rekord ebben a versenyszámban.</p>
  </div>
<% end %>
