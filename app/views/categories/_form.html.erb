<% if category.errors.any? %>
  <div class="error-box">
    <strong>A mentés nem sikerült:</strong>
    <ul>
      <% category.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: category do |f| %>
  <div class="form-group">
    <%= f.label :name, "Versenyszám neve *", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true, placeholder: "pl. 100m sörfutás" %>
  </div>

  <div class="form-group">
    <%= f.label :description, "Szabályzat / leírás", class: "form-label" %>
    <%= f.text_area :description, class: "form-control", placeholder: "Teljesítési feltételek és szabályok..." %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :unit, "Mértékegység *", class: "form-label" %>
      <%= f.text_field :unit, class: "form-control", required: true, placeholder: "pl. mp, kg, db, perc" %>
    </div>

    <div class="form-group">
      <%= f.label :value_type, "Érték típusa *", class: "form-label" %>
      <%= f.select :value_type,
        [["Egész szám (INT)", "INT"], ["Törtszám (DOUBLE)", "DOUBLE"], ["Időtartam (TIME_DURATION)", "TIME_DURATION"], ["Dátum (DATE)", "DATE"]],
        {},
        class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :sort_direction, "Rendezési irány *", class: "form-label" %>
      <%= f.select :sort_direction,
        [["Nagyobb jobb (DESC)", "DESC"], ["Kisebb / gyorsabb jobb (ASC)", "ASC"]],
        {},
        class: "form-control" %>
    </div>
  </div>

  <% if admin? && category.persisted? %>
    <div class="form-group">
      <label class="form-label">
        <%= f.check_box :is_archived %> Archivált versenyszám (új rekord nem küldhető be)
      </label>
    </div>
  <% end %>

  <div class="actions-inline">
    <%= f.submit(category.persisted? ? "Változtatások mentése" : "Versenyszám létrehozása", class: "btn btn-primary") %>
    <%= link_to "Mégse", (category.persisted? ? category_path(category) : root_path), class: "btn btn-outline" %>
  </div>
<% end %>
